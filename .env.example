# ==============================================================================
# Mobile Manufacturing System - Environment Configuration
# ==============================================================================

# Oracle Database Configuration
# DSN format: host:port/service_name (Default XE pluggable database is XEPDB1)
DB_USER=mms_user
DB_PASSWORD=mms_password
DB_DSN=localhost:1521/XEPDB1
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1

# Fallback mode (Set to true if Oracle XE is temporarily unavailable for offline demo)
# When false, the application strictly communicates with Oracle 21c XE.
USE_FALLBACK_IF_ORACLE_OFFLINE=true

# Application Security
JWT_SECRET_KEY=manipal-mit-mca-dbms-mobile-manufacturing-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backend Server Config
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

